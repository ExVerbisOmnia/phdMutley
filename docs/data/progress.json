      "created_at": "2026-03-04 23:57:30"
    },
    {
      "id": "D12",
      "title": "Title-based document classification",
      "rationale": "Use Document Title keyword (after last \" - \" separator) instead of unreliable Document Type column. 84 unique keywords mapped to decision/non-decision/ambiguous buckets.",
      "source": "Session 6 Mar",
      "status": "active",
      "phase_id": 109,
      "created_at": "2026-03-06 14:32:56"
    },
    {
      "id": "D13",
      "title": "LLM classification for ambiguous documents",
      "rationale": "4,084 docs without clear title keyword (\"other\" or no separator) classified via partial text extraction (first+last 2,400 chars) + Gemini. Cost: ~.08.",
      "source": "Session 6 Mar",
      "status": "active",
      "phase_id": 109,
      "created_at": "2026-03-06 14:32:56"
    },
    {
      "id": "D14",
      "title": "GCP VM on Lucas project for pipeline execution",
      "rationale": "Use Lucas GCP project (gen-lang-client-0764097936) for VM + secrets. e2-standard-16 Spot instance. Avoids billing on Gustavo personal project. VM cost: </job.",
      "source": "Session 6 Mar",
      "status": "implemented",
      "phase_id": 109,
      "created_at": "2026-03-06 14:32:56"
    },
    {
      "id": "D15",
      "title": "Workers = CPU count (8 local, 16 VM)",
      "rationale": "SAFE_WORKERS matches logical processor count. Local: 8 vCPU / 8GB RAM. VM: 16 vCPU / 64GB RAM. Each pdfplumber worker uses ~200MB. Comfortable headroom in both environments.",
      "source": "Session 6 Mar",
      "status": "active",
      "phase_id": 109,
      "created_at": "2026-03-06 14:32:56"
    },
    {
      "id": "D2",
      "title": "Gemini as primary LLM",
      "rationale": "Cheaper, matches benchmarks, Lucas has credits",
      "source": "Meeting 3 Mar",
      "status": "implemented",
      "phase_id": null,
      "created_at": "2026-03-04 23:57:30"
    },
    {
      "id": "D3",
      "title": "Markdown text extraction",
      "rationale": "Better optimized for LLM processing",
      "source": "Meeting 3 Mar",
      "status": "pending",
      "phase_id": 3,
      "created_at": "2026-03-04 23:57:30"
    },
    {
