{
  "_doc": [
    "Project-local STRICT permissions for the corpus-run orchestrator's unattended --print sessions.",
    "",
    "Inheritance reminder: Claude Code merges this with the global ~/.claude/settings.json and the",
    "committed ./.claude/settings.json ADDITIVELY for `allow` patterns. The only way to RESTRICT a globally-",
    "allowed pattern is via an explicit `deny` rule here (deny wins on conflict).",
    "",
    "This file is gitignored (.claude/settings.local.json). It only takes effect on this machine, in this",
    "project. Other projects retain Gus's normal (lax) global settings.",
    "",
    "DO NOT pair this with --dangerously-skip-permissions on the CLI — that flag bypasses ALL permission",
    "checks including the deny list below. The wrapper script (scripts/loop_corpus_orchestrator.sh) was",
    "updated to drop the flag once this file is in place.",
    "",
    "Test before kicking off a long run: `bash scripts/loop_corpus_orchestrator.sh --max-sessions 1`",
    "and inspect logs/corpus_session_*.log to verify the inner Claude session proceeded without blocking."
  ],
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "Write(data/extraction_results/**)",
      "Write(data/decisions_md_chunks/**)",
      "Write(logs/**)",
      "Bash(python scripts/orchestrator_helper.py:*)",
      "Bash(python scripts/chunk_large_docs.py:*)",
      "Bash(python scripts/merge_chunk_results.py:*)",
      "Bash(python -c import json:*)",
      "Bash(python -m json.tool:*)",
      "Bash(mkdir -p data/extraction_results:*)",
      "Bash(mkdir -p data/decisions_md_chunks:*)",
      "Bash(mkdir -p logs:*)",
      "Bash(wc -l:*)"
    ],
    "deny": [
      "_comment_destructive_filesystem",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(dd:*)",
      "Bash(truncate:*)",
      "Bash(:>:*)",

      "_comment_destructive_git",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag:*)",

      "_comment_destructive_db",
      "Bash(dropdb:*)",
      "Bash(psql:*)",
      "Bash(pg_restore:*)",
      "Bash(pg_dump:*)",

      "_comment_network_egress_kill_data_exfil_via_prompt_injection",
      "WebFetch(*)",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ftp:*)",
      "Bash(telnet:*)",

      "_comment_package_install_no_drift",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(yarn add:*)",
      "Bash(poetry add:*)",
      "Bash(poetry install:*)",
      "Bash(brew:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",

      "_comment_protect_rules_and_scripts_from_self_modification",
      "Edit(.claude/**)",
      "Edit(.git/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Write(.claude/**)",
      "Write(.git/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(data/decisions_md/**)",
      "Write(data/decisions_md_raw/**)",
      "Write(data/backups/**)",

      "_comment_dangerous_shells_and_eval",
      "Bash(eval:*)",
      "Bash(source:*)",
      "Bash(exec:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(zsh -c:*)",

      "_comment_no_long_running_servers_or_processes",
      "Bash(systemctl:*)",
      "Bash(service:*)",
      "Bash(launchctl:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(crontab:*)",
      "Bash(at:*)"
    ],
    "defaultMode": "auto"
  }
}
