 # phdMutley environment overrides
  # ----------------------------------------------------------------------
  # Copy this file to `.env` and fill in real values. `.env` is gitignored.
  # Anything set here takes precedence over GCP Secret Manager — useful when
  # Secret Manager is unreachable (offline, billing issues) or for local dev.
  # Resolution order in scripts/gcp_secrets.py: env var -> Secret Manager.
  # ----------------------------------------------------------------------

  # ----- Credentials (override Secret Manager when set) -----

  # Local PostgreSQL password. Required when Secret Manager is unavailable.
  # Secret name in GCP: phdmutley-db-password
  DB_PASSWORD=

  # Gemini API key — single-key path used by extraction/verification calls.
  # Secret name in GCP: phdmutley-gemini-api-key
  GEMINI_API_KEY=

  # Gemini multi-key rotation (used by gcp_secrets.get_gemini_api_keys).
  # Set as many as you have; primaries are tried before fallbacks.
  GEMINI_KEY_NATY=
  GEMINI_KEY_ORLANDO=
  GEMINI_KEY_MUTLEY1=
  GEMINI_KEY_MUTLEY2=

  # ----- DB connection params (non-secret, override defaults if needed) -----

  # Default: localhost
  DB_HOST=
  # Default: 5433 (local native PostgreSQL 18). VM uses 5432.
  DB_PORT=

  # ----- GCP routing -----

  # Which GCP project hosts the secrets. Default: extreme-hull-489213-p9.
  # Set to gen-lang-client-0764097936 only when running on the GCP VM.
  GCP_SECRET_PROJECT=

  # ----- Push notifications (optional, sane defaults) -----

  # Default: https://ntfy.sh
  NTFY_SERVER=
  # Default: phdmutley-pipeline
  NTFY_TOPIC=